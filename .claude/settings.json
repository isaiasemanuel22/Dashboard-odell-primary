{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/tests-relacionados.sh",
            "timeout": 120,
            "statusMessage": "Tests relacionados..."
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "compact",
        "hooks": [
          {
            "type": "command",
            "command": "echo 'Recordatorio: agentes devuelven JSON corto; nada de logs largos.'"
          }
        ]
      }
    ]
  }
}
