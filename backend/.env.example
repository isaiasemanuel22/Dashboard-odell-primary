# Copiá a .env (y opcionalmente .env.local para overrides personales)
# Desarrollo local — NO uses la base ni credenciales de producción.

NODE_ENV=development
PORT=3000

# MySQL local
DATABASE_URL="mysql://odell:TU_PASSWORD@localhost:3306/odell_dashboard"

# Frontend local (ng serve)
CORS_ORIGINS=http://localhost:4200

# Datos demo si la base está vacía
AUTO_SEED=false

# Auth Firebase opcional en dev (si no está, algunas rutas pueden fallar)
# REQUIRE_AUTH=false
# REQUIRE_DATABASE=false

# Código para POST /settings/reset-database (solo admin). Sin valor = deshabilitado.
# DATABASE_RESET_CODE=

# Email que siempre entra como administrador (debe estar verificado en Firebase).
# ADMIN_EMAIL=

# Avisos automáticos (§28.5). Sin RESEND_API_KEY el resumen de saldos no se manda.
# Hasta conectar Meta, el WhatsApp queda en el log del servidor.
# RESEND_API_KEY=
# ALERTS_EMAIL_FROM=
# ALERTS_EMAIL_TO=
# ALERTS_WHATSAPP_TO=

# Firebase Admin — obligatorio para subir imágenes (POST /api/upload)
# FIREBASE_SERVICE_ACCOUNT_PATH=firebase-service-account.json
# FIREBASE_STORAGE_BUCKET=dashboard-odell-2.firebasestorage.app
