generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

model AppSettings {
  id                    Int   @id @default(1)
  electricityCostPerKwh Float @default(0) @map("electricity_cost_per_kwh")
  laborCostPerHour      Float @default(0) @map("labor_cost_per_hour")
  modelingRatePerHour   Float @default(0) @map("modeling_rate_per_hour")
  graphicDesignRatePerHour Float @default(0) @map("graphic_design_rate_per_hour")
  errorMarginPercent    Float @default(0) @map("error_margin_percent")
  profitMargins         Json  @map("profit_margins")
  paperPricesPerSqm     Json  @map("paper_prices_per_sqm")
  paperReferenceSheets  Json  @default("{}") @map("paper_reference_sheets")
  powerConsumptions     Json  @map("power_consumptions")
  machineCosts          Json  @map("machine_costs")
  processProfiles       Json  @default("[]") @map("process_profiles")
  filamentPrices        Json  @map("filament_prices")
  resinPrices           Json  @map("resin_prices")
  filamentTypeAverages  Json  @default("{}") @map("filament_type_averages")
  resinTypeAverages     Json  @default("{}") @map("resin_type_averages")
  colors                Json  @default("[]")
  filamentTypes         Json  @default("[]") @map("filament_types")

  @@map("app_settings")
}

model Brand {
  id            String   @id @db.VarChar(64)
  name          String   @unique @db.VarChar(128)
  materialTypes Json     @map("material_types")
  createdAt     DateTime @map("created_at")

  @@map("brands")
}

model Category {
  id           String   @id @db.VarChar(64)
  name         String   @db.VarChar(255)
  productTypes Json     @map("product_types")
  createdAt    DateTime @map("created_at")

  @@map("categories")
}

model Customer {
  id        String   @id @db.VarChar(64)
  name      String   @db.VarChar(255)
  email     String   @db.VarChar(255)
  phone     String   @db.VarChar(64)
  company   String?  @db.VarChar(255)
  createdAt DateTime @map("created_at")

  orders Order[]
  quotes Quote[]

  @@map("customers")
}

model Product {
  id                String   @id @db.VarChar(64)
  name              String   @db.VarChar(255)
  images            Json
  updatedAt         DateTime @map("updated_at")
  price             Float
  cost              Float
  profit            Float
  categoryIds       Json     @map("category_ids")
  type              String   @db.VarChar(32)
  size              String   @db.VarChar(128)
  published         Boolean  @default(true)
  components        Json
  assemblyTimeHours Float    @default(0) @map("assembly_time_hours")
  grams             Float?
  printTimeHours    Float?   @map("print_time_hours")
  workTimeHours     Float?   @map("work_time_hours")
  brandId           String?  @map("brand_id") @db.VarChar(64)
  filamentType      String?  @map("filament_type") @db.VarChar(32)
  resinType         String?  @map("resin_type") @db.VarChar(32)
  washMinutes       Float?   @map("wash_minutes")
  cureMinutes       Float?   @map("cure_minutes")
  pressMinutes      Float?   @map("press_minutes")
  paperType         String?  @map("paper_type") @db.VarChar(32)
  impresoId         String?  @map("impreso_id") @db.VarChar(64)
  widthCm           Float?   @map("width_cm")
  heightCm          Float?   @map("height_cm")
  estampadoPrints       Json @default("[]") @map("estampado_prints")
  estampadoPressCycles  Json @default("[]") @map("estampado_press_cycles")
  estampadoSupplies     Json @default("[]") @map("estampado_supplies")
  fdmFilaments          Json @default("[]") @map("fdm_filaments")
  includesPieces        Boolean @default(false) @map("includes_pieces")
  attachments           Json    @default("[]") @map("attachments")
  stock                 Int     @default(0)
  colorId               String? @map("color_id") @db.VarChar(64)

  @@map("products")
}

model Supply {
  id                String   @id @db.VarChar(64)
  name              String   @db.VarChar(255)
  category          String   @default("general") @db.VarChar(32)
  filamentType      String?  @map("filament_type") @db.VarChar(32)
  resinType         String?  @map("resin_type") @db.VarChar(32)
  brandId           String?  @map("brand_id") @db.VarChar(64)
  unit              String   @db.VarChar(32)
  quantity          Float
  minStock          Float    @map("min_stock")
  unitPrice         Float    @map("unit_price")
  priceFromSettings Boolean  @default(false) @map("price_from_settings")
  supplier          String?  @db.VarChar(255)
  colorId           String?  @map("color_id") @db.VarChar(64)
  updatedAt         DateTime @map("updated_at")

  @@map("supplies")
}

model Impreso {
  id        String   @id @db.VarChar(64)
  name      String   @db.VarChar(255)
  paperType String   @map("paper_type") @db.VarChar(32)
  widthCm   Float    @map("width_cm")
  lengthCm  Float?   @map("length_cm")
  heightCm  Float    @map("height_cm")
  updatedAt DateTime @map("updated_at")

  @@map("impresos")
}

model Order {
  id           String   @id @db.VarChar(64)
  customerId   String?  @map("customer_id") @db.VarChar(64)
  customerName String   @map("customer_name") @db.VarChar(255)
  services     Json
  status       String   @db.VarChar(32)
  total        Float
  discountPercent Float @default(0) @map("discount_percent")
  discountAmount  Float @default(0) @map("discount_amount")
  description  String?  @db.Text
  notes        String?  @db.Text
  createdAt    DateTime @map("created_at")
  dueDate      DateTime @map("due_date")
  statusHistory Json    @default("[]") @map("status_history")
  priceHistory  Json    @default("[]") @map("price_history")
  deliveryHistory Json  @default("[]") @map("delivery_history")

  customer Customer?   @relation(fields: [customerId], references: [id], onDelete: Restrict)
  items    OrderItem[]

  @@index([customerId])
  @@map("orders")
}

model OrderItem {
  id          String @id @db.VarChar(80)
  orderId     String @map("order_id") @db.VarChar(64)
  sortIndex   Int    @map("sort_index")
  serviceType String @map("service_type") @db.VarChar(32)
  productId   String? @map("product_id") @db.VarChar(64)
  productName String @map("product_name") @db.VarChar(255)
  quantity    Int
  unitPrice   Float  @map("unit_price")
  includesPrint Boolean @default(false) @map("includes_print")
  printPaperType String? @map("print_paper_type") @db.VarChar(32)
  printWidthCm Float? @map("print_width_cm")
  printLengthCm Float? @map("print_length_cm")
  printImpresoId String? @map("print_impreso_id") @db.VarChar(64)
  designUnitPrice Float? @map("design_unit_price")
  printTimeHours Float? @map("print_time_hours")
  grams         Float?
  filamentType  String? @map("filament_type") @db.VarChar(32)
  estampadoPrints      Json @default("[]") @map("estampado_prints")
  estampadoPressCycles Json @default("[]") @map("estampado_press_cycles")
  estampadoSupplies    Json @default("[]") @map("estampado_supplies")
  deliveredQuantity Int @default(0) @map("delivered_quantity")
  reservedQuantity Int @default(0) @map("reserved_quantity")
  productionRequiredQuantity Int @default(0) @map("production_required_quantity")
  producedQuantity Int @default(0) @map("produced_quantity")
  deliveredFromProductionQuantity Int @default(0) @map("delivered_from_production_quantity")

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@map("order_items")
}

model Quote {
  id              String   @id @db.VarChar(64)
  customerId      String?  @map("customer_id") @db.VarChar(64)
  customerName    String   @map("customer_name") @db.VarChar(255)
  services        Json
  status          String   @default("borrador") @db.VarChar(32)
  total           Float
  discountPercent Float    @default(0) @map("discount_percent")
  discountAmount  Float    @default(0) @map("discount_amount")
  description     String?  @db.Text
  quotedAt        DateTime @map("quoted_at")
  createdAt       DateTime @map("created_at")
  orderId         String?  @map("order_id") @db.VarChar(64)

  customer Customer?  @relation(fields: [customerId], references: [id], onDelete: Restrict)
  items    QuoteItem[]

  @@index([customerId])
  @@index([orderId])
  @@map("quotes")
}

model QuoteItem {
  id              String  @id @db.VarChar(80)
  quoteId         String  @map("quote_id") @db.VarChar(64)
  sortIndex       Int     @map("sort_index")
  serviceType     String  @map("service_type") @db.VarChar(32)
  productId       String? @map("product_id") @db.VarChar(64)
  productName     String  @map("product_name") @db.VarChar(255)
  quantity        Int
  unitPrice       Float   @map("unit_price")
  includesPrint   Boolean @default(false) @map("includes_print")
  printPaperType  String? @map("print_paper_type") @db.VarChar(32)
  printWidthCm    Float?  @map("print_width_cm")
  printLengthCm   Float?  @map("print_length_cm")
  printImpresoId  String? @map("print_impreso_id") @db.VarChar(64)
  designUnitPrice Float?  @map("design_unit_price")
  printTimeHours  Float?  @map("print_time_hours")
  grams           Float?
  filamentType    String? @map("filament_type") @db.VarChar(32)
  estampadoPrints      Json @default("[]") @map("estampado_prints")
  estampadoPressCycles Json @default("[]") @map("estampado_press_cycles")
  estampadoSupplies    Json @default("[]") @map("estampado_supplies")

  quote Quote @relation(fields: [quoteId], references: [id], onDelete: Cascade)

  @@index([quoteId])
  @@map("quote_items")
}

model PrintJob {
  id             String    @id @db.VarChar(64)
  orderId        String    @map("order_id") @db.VarChar(64)
  orderItemIndex Int       @map("order_item_index")
  customerName   String    @map("customer_name") @db.VarChar(255)
  productName    String    @map("product_name") @db.VarChar(255)
  productId      String?   @map("product_id") @db.VarChar(64)
  type           String    @db.VarChar(32)
  status         String    @db.VarChar(32)
  active         Boolean   @default(false)
  priority       Int
  machine        String    @db.VarChar(128)
  estimatedHours Float     @map("estimated_hours")
  dueDate        DateTime  @map("due_date")
  startedAt      DateTime? @map("started_at")
  completedAt    DateTime? @map("completed_at")
  taskType        String    @default("SERVICE") @map("task_type") @db.VarChar(32)
  quantity        Int       @default(1)
  archived        Boolean   @default(false)
  blockedReason   String?   @map("blocked_reason") @db.VarChar(255)
  responsibleUserId String? @map("responsible_user_id") @db.VarChar(128)
  suppliesAvailableNotifiedAt DateTime? @map("supplies_available_notified_at")

  @@index([orderId])
  @@map("print_jobs")
}

model RetailSale {
  id              String           @id @db.VarChar(64)
  total           Float
  discountPercent Float            @default(0) @map("discount_percent")
  discountAmount  Float            @default(0) @map("discount_amount")
  notes           String?          @db.Text
  soldAt    DateTime         @map("sold_at")
  createdAt DateTime         @map("created_at")
  items     RetailSaleItem[]

  @@map("retail_sales")
}

model RetailSaleItem {
  id           String @id @db.VarChar(80)
  retailSaleId String @map("retail_sale_id") @db.VarChar(64)
  sortIndex    Int    @map("sort_index")
  productId    String? @map("product_id") @db.VarChar(64)
  productName  String @map("product_name") @db.VarChar(255)
  quantity     Int
  unitPrice    Float  @map("unit_price")
  lineTotal    Float  @map("line_total")

  retailSale RetailSale @relation(fields: [retailSaleId], references: [id], onDelete: Cascade)

  @@index([retailSaleId])
  @@map("retail_sale_items")
}

model TreasuryExpense {
  id          String   @id @db.VarChar(64)
  direction    String   @default("expense") @db.VarChar(16)
  category    String   @db.VarChar(32)
  name        String   @default("") @db.VarChar(255)
  quantity    Float    @default(1)
  unitPrice   Float    @default(0) @map("unit_price")
  amount      Float
  description String?  @db.VarChar(255)
  referenceId String?  @map("reference_id") @db.VarChar(64)
  occurredAt  DateTime @map("occurred_at")
  createdAt   DateTime @map("created_at")

  @@index([referenceId])
  @@map("treasury_expenses")
}

model CalendarEntry {
  id          String    @id @db.VarChar(64)
  kind        String    @db.VarChar(16)
  title       String    @db.VarChar(255)
  notes       String?   @db.Text
  date        String    @db.VarChar(10)
  startTime   String?   @map("start_time") @db.VarChar(8)
  endTime     String?   @map("end_time") @db.VarChar(8)
  allDay      Boolean   @default(false) @map("all_day")
  repeat      String    @default("none") @db.VarChar(16)
  weekdays    Json      @default("[]")
  notify      String    @default("none") @db.VarChar(16)
  linkType    String?   @map("link_type") @db.VarChar(16)
  linkId      String?   @map("link_id") @db.VarChar(64)
  completedAt DateTime? @map("completed_at")
  createdAt   DateTime  @map("created_at")
  updatedAt   DateTime  @map("updated_at")

  @@index([date])
  @@index([kind])
  @@map("calendar_entries")
}

model WorkArea {
  id        String   @id @db.VarChar(64)
  name      String   @db.VarChar(128)
  slug      String   @unique @db.VarChar(64)
  active    Boolean  @default(true)
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @map("created_at")
  updatedAt DateTime @map("updated_at")

  rolePermissions         RolePermission[]
  userPermissionOverrides UserPermissionOverride[]

  @@map("work_areas")
}

model AppRole {
  id          String   @id @db.VarChar(64)
  name        String   @db.VarChar(128)
  description String?  @db.VarChar(255)
  isSystem    Boolean  @default(false) @map("is_system")
  createdAt   DateTime @map("created_at")
  updatedAt   DateTime @map("updated_at")

  permissions RolePermission[]
  userRoles   UserRole[]

  @@map("app_roles")
}

model RolePermission {
  id     String  @id @db.VarChar(64)
  roleId String  @map("role_id") @db.VarChar(64)
  areaId String? @map("area_id") @db.VarChar(64)
  action String  @db.VarChar(32)

  role AppRole   @relation(fields: [roleId], references: [id], onDelete: Cascade)
  area WorkArea? @relation(fields: [areaId], references: [id], onDelete: Cascade)

  @@unique([roleId, areaId, action])
  @@index([roleId])
  @@map("role_permissions")
}

model AppUser {
  id          String   @id @db.VarChar(64)
  firebaseUid String?  @unique @map("firebase_uid") @db.VarChar(128)
  email       String   @db.VarChar(255)
  displayName String   @map("display_name") @db.VarChar(255)
  active      Boolean  @default(true)
  createdAt   DateTime @map("created_at")
  updatedAt   DateTime @map("updated_at")

  userRoles             UserRole[]
  permissionOverrides   UserPermissionOverride[]

  @@map("app_users")
}

model UserRole {
  userId String @map("user_id") @db.VarChar(64)
  roleId String @map("role_id") @db.VarChar(64)

  user AppUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  role AppRole @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@map("user_roles")
}

model UserPermissionOverride {
  id      String  @id @db.VarChar(64)
  userId  String  @map("user_id") @db.VarChar(64)
  areaId  String? @map("area_id") @db.VarChar(64)
  action  String  @db.VarChar(32)
  granted Boolean @default(true)

  user AppUser   @relation(fields: [userId], references: [id], onDelete: Cascade)
  area WorkArea? @relation(fields: [areaId], references: [id], onDelete: Cascade)

  @@unique([userId, areaId, action])
  @@index([userId])
  @@map("user_permission_overrides")
}
