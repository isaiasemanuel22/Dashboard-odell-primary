# Copiá a .env.e2e (ignorado en git). Todo es opcional en local.
# E2E_BASE_URL=http://localhost:4300
# E2E_API_URL=http://localhost:3000/api
# El login local (testing@test.com / 123456) esta hardcodeado en AuthService solo fuera de produccion
# y el backend con REQUIRE_AUTH!=true acepta llamadas sin token. Solo hace falta definir esto si
# apuntas a un entorno con Firebase real (NUNCA produccion):
# E2E_EMAIL=
# E2E_PASSWORD=
# E2E_BEARER_TOKEN=
# Usa Chrome del sistema en vez del Chromium de Playwright: E2E_CHANNEL=chrome
# E2E_CHANNEL=chrome
